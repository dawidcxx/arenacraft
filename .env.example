# Arenacraft runtime configuration.
# Loaded automatically from ./.env by `ac authserver` / `ac worldserver`,
# or pass an explicit file: `ac worldserver --env-file /path/to/.env`.
# Variables already present in the environment always win.

# --- required: database connections (authserver needs only the first) ---
# format: "hostname;port;username;password;database"
AC_LOGIN_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_auth"
AC_CHARACTER_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_characters"
AC_WORLD_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_world"

# --- database setup (scripts/db_sync) ---
# root connection used to create the databases and users: "hostname;port;username;password"
AC_ROOT_DATABASE_INFO="127.0.0.1;3306;root;acore"

# --- optional ---
#AC_REALMID=1
# client data dir, resolved relative to the ac binary unless absolute
#AC_DATA_DIR=../../data
# directory for crash reports (created if missing); unset => stderr only
#AC_CRASH_DIR=./crashes

# --- redis / valkey (best-effort event publishing; the world runs fine without it) ---
#AC_REDIS_ENABLED=1
#AC_REDIS_HOST=127.0.0.1
#AC_REDIS_PORT=6379
#AC_REDIS_PASSWORD=
#AC_REDIS_DB=0

# --- arena replays (recording + `.replay <id>` playback) ---
# master switch for recording; old recordings stay watchable when it is off
#AC_REPLAY_ENABLED=1
# which brackets to record, comma separated: 2v2, 3v3, 5v5, soloq, skirmish, all
#AC_REPLAY_BRACKETS=2v2,3v3,soloq
# retention, 0 = unlimited (applied after each saved match; KEEP_DAYS also at startup)
# delete recordings older than N days
#AC_REPLAY_KEEP_DAYS=30
# keep at most N recordings in total
#AC_REPLAY_MAX_TOTAL=5000
# keep at most N recordings per character (a match is deleted for everyone once
# it drops out of any participant's newest N)
#AC_REPLAY_MAX_PER_PLAYER=50
