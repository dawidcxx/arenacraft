# Arenacraft runtime configuration.
# Loaded automatically from ./.env by `ac authserver` / `ac worldserver`,
# or pass an explicit file: `ac worldserver --env-file /path/to/.env`.
# Variables already present in the environment always win.

# --- required: database connections (authserver needs only the first) ---
# format: "hostname;port;username;password;database"
AC_LOGIN_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_auth"
AC_CHARACTER_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_characters"
AC_WORLD_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_world"

# --- database setup (scripts/db_sync) ---
# root connection used to create the databases and users: "hostname;port;username;password"
AC_ROOT_DATABASE_INFO="127.0.0.1;3306;root;acore"

# --- optional ---
#AC_REALMID=1
# client data dir, resolved relative to the ac binary unless absolute
#AC_DATA_DIR=../../data
# directory for crash reports (created if missing); unset => stderr only
#AC_CRASH_DIR=./crashes

# --- performance / parallelism ---
# map update workers and world socket threads (built-in default: 2 / 2)
#AC_MAP_UPDATE_THREADS=2
#AC_NETWORK_THREADS=2
# minimum interval between world ticks in ms (10 => at most 100 Hz)
#AC_MIN_WORLD_UPDATE_TIME=10

# --- redis / valkey (best-effort event publishing; the world runs fine without it) ---
#AC_REDIS_ENABLED=1
#AC_REDIS_HOST=127.0.0.1
#AC_REDIS_PORT=6379
#AC_REDIS_PASSWORD=
#AC_REDIS_DB=0

# --- arena replays (recording + `.replay <id>` playback) ---
# master switch for recording and playback; when off, `.replay watch` is refused
#AC_REPLAY_ENABLED=1
# which brackets to record, comma separated: 2v2, 3v3, 5v5, soloq, skirmish, all
#AC_REPLAY_BRACKETS=2v2,3v3,soloq
# retention, 0 = unlimited (applied after each saved match; KEEP_DAYS also at startup)
# delete recordings older than N days
#AC_REPLAY_KEEP_DAYS=30
# keep at most N recordings in total
#AC_REPLAY_MAX_TOTAL=5000
# keep at most N recordings per character (a match is deleted for everyone once
# it drops out of any participant's newest N)
#AC_REPLAY_MAX_PER_PLAYER=50

# --- patrol (players review reported replays anonymously, see ai-doc/patrol.md) ---
# master switch for `.replay report` and `.patrol accept`; needs AC_REPLAY_ENABLED too
#AC_PATROL_ENABLED=1
# who may review: solo queue games this season
#AC_PATROL_MIN_GAMES=50
# patroller's soloq rating must be within +-N of the suspect's rating when reported
# (200: a 1500 suspect goes to 1300-1700 patrollers); 0 = any rating
#AC_PATROL_RATING_WINDOW=0
# staff accounts skip the games / rating requirements
#AC_PATROL_STAFF_EXEMPT=1
# reportable categories, comma separated: cheating, automation, griefing, wintrading, all
# (patrollers are asked one yes/no question per enabled category)
#AC_PATROL_CATEGORIES=all
# reports per account per day, 0 = unlimited
#AC_PATROL_MAX_REPORTS_PER_DAY=10
# only matches at most N hours old can be reported, 0 = as long as the replay exists
#AC_PATROL_REPORT_WINDOW_HOURS=0
# verdicts that close a case, and "yes" votes in one category that convict
#AC_PATROL_VERDICTS=5
#AC_PATROL_YES_TO_BAN=4
# what a conviction does: account (ban the account), character (ban that character),
# none (only mark the case, staff decide from `.patrol cases`)
#AC_PATROL_PUNISHMENT=account
# ban length: 30m, 12h, 7d, 1d12h, ...; 0 = permanent
#AC_PATROL_BAN_DURATION=7d
