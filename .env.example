# Arenacraft runtime configuration.
# Loaded automatically from ./.env by `ac authserver` / `ac worldserver`,
# or pass an explicit file: `ac worldserver --env-file /path/to/.env`.
# Variables already present in the environment always win.

# --- required: database connections (authserver needs only the first) ---
# format: "hostname;port;username;password;database"
AC_LOGIN_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_auth"
AC_CHARACTER_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_characters"
AC_WORLD_DATABASE_INFO="127.0.0.1;3306;acore;acore;acore_world"

# --- optional ---
#AC_REALMID=1
#AC_REDIS_HOST=127.0.0.1
#AC_REDIS_PORT=6379
#AC_DATADIR=data
