.git
.gitignore
.env*
.flake.lock.orig
**/node_modules
# host build/cache state: never ship it into the ubuntu build context (the
# Dockerfile keeps its own caches via --mount=type=cache)
.zig-cache
zig-pkg
zig-out
.direnv
.cache
compile_commands.json
/data
/backups
*.log
OLD_SCRIPTS.md
Dockerfile
docker-compose.yml
# host-only tooling, never COPYed into the image (the 200MB+ debug `ac` at the
# repo root would otherwise be uploaded as build context on every build)
/ac
/apps
/scripts
/ai-doc
