{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install",
            "type": "shell",
            "command": "bun",
            "args": [
                "run",
                "${workspaceFolder}/scripts/bin/install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "kill",
            "type": "shell",
            "command": "pkill -9 worldserver || true",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "install&kill",
            "dependsOn": [
                "install",
                "kill"
            ],
            "dependsOrder": "sequence"
        }
    ]
}