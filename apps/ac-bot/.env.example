# Discord bot token (Developer Portal -> Bot -> Reset Token).
DISCORD_TOKEN=

# The single guild the bot serves (Developer Portal -> General Information ->
# Application ID is not needed; right-click the server -> Copy Server ID).
DISCORD_GUILD_ID=

# Auth database the bot writes new accounts to (mysql URI).
AUTH_DB_URL=mysql://acore:acore@127.0.0.1:3306/acore_auth

# Characters database the bot reads solo queue rankings from (mysql URI).
CHARACTER_DB_URL=mysql://acore:acore@127.0.0.1:3306/acore_characters

# Redis/Valkey the core publishes soloq events to.
REDIS_URL=redis://127.0.0.1:6379

# Voice layout. Rooms are pairs named "<prefix>-<n>-1"/"<prefix>-<n>-2" and are
# discovered dynamically.
WAITING_ROOM_NAME=Waiting Room
GAME_CHANNEL_PATTERN=^game-(\d+)-(\d+)$

# Optional channel for "no free room" notices.
INFO_CHANNEL_NAME=bot

# Reclaim a room whose ended event never arrived.
STALE_ROOM_MINUTES=60
