<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Arenacraft Launcher"
           Manufacturer="Arenacraft"
           Version="$(var.Version)"
           UpgradeCode="FD4F78DF-0F00-47E3-88C3-E23A6DDBE2B9"
           Scope="perMachine"
           Language="1033"
           ProductCode="*">

    <!-- Same-version rebuilds are a supported flow (re-running a release for an
         existing tag), so treat them as upgrades of the previous install. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of the Arenacraft Launcher is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The install directory is the World of Warcraft directory, so the wizard
         has to show it. WixUI_InstallDir is the dialog set with a folder page;
         WixUI_Mondo (the previous choice) only exposes the folder through its
         Customise dialog, which makes the picker easy to miss. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerDir)\License.rtf" />

    <!-- Directory to pre-select in the folder page, in order:
           1. the directory this launcher was installed into (our own key, so
              an upgrade or reinstall lands where the user put it last time),
           2. the client Blizzard registered,
           3. Program Files\World of Warcraft (the Directory element below).
         Every SetProperty condition excludes the earlier steps, so the three
         are mutually exclusive and their action order cannot matter. The
         NOT INSTALLDIR term keeps an INSTALLDIR passed on the msiexec command
         line, and a reinstall of the same ProductCode, untouched. -->
    <Property Id="ARENACRAFTWOWDIR">
      <!-- Written below by LauncherComponent; the package is x64, so its
           registry values live in the 64-bit view. -->
      <RegistrySearch Id="ArenacraftInstallPath"
                      Root="HKLM"
                      Key="SOFTWARE\Arenacraft\Launcher"
                      Name="InstallPath"
                      Type="directory"
                      Bitness="always64" />
    </Property>
    <Property Id="BLIZZARDWOWDIR">
      <!-- 3.3.5a is a 32-bit client, so its key is in the 32-bit view even on
           64-bit Windows. -->
      <RegistrySearch Id="BlizzardInstallPath"
                      Root="HKLM"
                      Key="SOFTWARE\Blizzard Entertainment\World of Warcraft"
                      Name="InstallPath"
                      Type="directory"
                      Bitness="always32" />
    </Property>
    <!-- Action= is required here: both actions set INSTALLDIR, and without a
         distinct name each would generate the same SetINSTALLDIR action. -->
    <SetProperty Action="SetWowDirFromArenacraft" Id="INSTALLDIR" Value="[ARENACRAFTWOWDIR]"
                 Before="CostFinalize" Sequence="both"
                 Condition="NOT Installed AND NOT INSTALLDIR AND ARENACRAFTWOWDIR" />
    <SetProperty Action="SetWowDirFromBlizzard" Id="INSTALLDIR" Value="[BLIZZARDWOWDIR]"
                 Before="CostFinalize" Sequence="both"
                 Condition="NOT Installed AND NOT INSTALLDIR AND NOT ARENACRAFTWOWDIR AND BLIZZARDWOWDIR" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="World of Warcraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ArenacraftMenuFolder" Name="Arenacraft" />
    </StandardDirectory>

    <Component Id="LauncherComponent" Directory="INSTALLDIR" Guid="*">
      <File Id="ArenacraftExe" Source="$(var.SourceDir)\Arenacraft.exe" KeyPath="yes" />
      <!-- The update path: the next version's MSI reads this back as
           ARENACRAFTWOWDIR to pre-select the directory the user picked. -->
      <RegistryValue Root="HKLM" Key="Software\Arenacraft\Launcher"
                     Name="InstallPath" Type="string" Value="[INSTALLDIR]" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcut" Name="Arenacraft"
                Target="[INSTALLDIR]Arenacraft.exe" WorkingDirectory="INSTALLDIR" />
      <RegistryValue Root="HKLM" Key="Software\Arenacraft\Launcher"
                     Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcutComponent" Directory="ArenacraftMenuFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut" Name="Arenacraft"
                Target="[INSTALLDIR]Arenacraft.exe" WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="RemoveArenacraftMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Arenacraft\Launcher"
                     Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="LauncherFeature" Title="Arenacraft Launcher" Level="1" AllowAbsent="no">
      <ComponentRef Id="LauncherComponent" />
    </Feature>
    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="1">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
    <Feature Id="StartMenuShortcutFeature" Title="Start menu shortcut" Level="1">
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Binary Id="WowCheckScript" SourceFile="$(var.InstallerDir)\wowcheck.js" />
    <CustomAction Id="ValidateWowDir"
                  BinaryRef="WowCheckScript"
                  JScriptCall="ValidateWowDir"
                  Execute="immediate"
                  Return="check" />

    <InstallExecuteSequence>
      <!-- After CostFinalize (INSTALLDIR is resolved) but before
           RemoveExistingProducts/InstallFiles: a rejected directory must not
           uninstall the previous launcher. Not scheduled in the UI sequence,
           where the folder page has not run yet. -->
      <Custom Action="ValidateWowDir" After="CostFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>
</Wix>
