{
  "name": "@arenacraft/common",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && bun run ./build.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "bundle:watch": "bun build ./src/index.ts --outdir ./dist --target browser --format esm --external valibot --watch",
    "types:watch": "tsc --emitDeclarationOnly --watch",
    "dev": "bun run bundle:watch & bun run types:watch",
    "test": "tsc --noEmit && bun test"
  },
  "dependencies": {
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.0"
  }
}